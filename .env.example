# ─────────────────────────────────────────────────────────────────────────────
# Flowen Platform — Environment Variables
#
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.
#
# Required vs optional:
#   [REQUIRED]  — the app will crash or refuse to start without this
#   [optional]  — feature degrades gracefully when absent
#   [build]     — must be set at build time (NEXT_PUBLIC_* baked into JS bundle)
#   [runtime]   — read at request time; can be changed in Vercel dashboard
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ──────────────────────────────────────────────────────────────────

# [REQUIRED] [build] Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# [REQUIRED] [build] Anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [REQUIRED] [runtime] Service-role key — server-side only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [optional] [runtime] HMAC secret for Supabase webhook payloads
SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret


# ── Stripe ────────────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_STRIPE_ENV=live in production. Use 'test' for development.

# [REQUIRED] [build] Controls which key set the static (build-time) Stripe client uses
NEXT_PUBLIC_STRIPE_ENV=test

# Test keys — safe for development, do NOT process real money
STRIPE_TEST_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...

# Live keys — real money; set only in production Vercel environment
STRIPE_LIVE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
STRIPE_LIVE_WEBHOOK_SECRET=whsec_...

# Fallback single-key setup (used if the TEST/LIVE variants above are absent)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for the Founding Member subscription tiers — test environment
STRIPE_TEST_PRICE_FOUNDING_MONTHLY=price_...
STRIPE_TEST_PRICE_FOUNDING_QUARTERLY=price_...
STRIPE_TEST_PRICE_FOUNDING_SIX_MONTHS=price_...
STRIPE_TEST_PRICE_FOUNDING_YEARLY=price_...

# Stripe Price IDs — live environment
STRIPE_PRICE_FOUNDING_MONTHLY=price_...
STRIPE_PRICE_FOUNDING_QUARTERLY=price_...
STRIPE_PRICE_FOUNDING_SIX_MONTHS=price_...
STRIPE_PRICE_FOUNDING_YEARLY=price_...


# ── Anthropic (AI coaching) ───────────────────────────────────────────────────

# [REQUIRED] [runtime] API key for Claude AI coaching feature
ANTHROPIC_API_KEY=sk-ant-...


# ── Resend (transactional email) ──────────────────────────────────────────────

# [REQUIRED] [runtime] API key for Resend email delivery
RESEND_API_KEY=re_...


# ── Upstash Redis (distributed rate limiting) ─────────────────────────────────
# When absent the rate limiter falls back to an in-process Map (dev/CI only).
# [REQUIRED in production] [runtime]

UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...


# ── Cron authentication ───────────────────────────────────────────────────────

# [REQUIRED] [runtime] Secret checked by verifyCronRequest() on all cron routes.
# Set this to match the Authorization header value Vercel sends for cron jobs.
CRON_SECRET=your_cron_secret_here


# ── Internal API secret ───────────────────────────────────────────────────────

# [REQUIRED] [runtime] Shared secret for server-to-server calls (e.g. affiliate convert)
INTERNAL_API_SECRET=your_internal_secret_here


# ── Identity verification (Didit) ─────────────────────────────────────────────

# [optional] [runtime] HMAC secret for Didit KYC webhook payloads
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret


# ── PostHog (analytics) ───────────────────────────────────────────────────────

# [optional] [build]
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com


# ── Sentry (error monitoring) ─────────────────────────────────────────────────

# [optional] [build]
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_ORG=your_sentry_org_slug


# ── Application URLs ──────────────────────────────────────────────────────────

# [REQUIRED] [build] Canonical public URL (used in email links, og:url, etc.)
NEXT_PUBLIC_SITE_URL=https://flowen.digital
NEXT_PUBLIC_APP_URL=https://app.flowen.digital


# ── Slack notifications ───────────────────────────────────────────────────────

# [optional] [runtime] Incoming webhook URL for ops alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz


# ── Google OAuth2 (shared — GA4 Data API + Google Ads) ───────────────────────
# One OAuth2 client used by both GA4 sync and Google Ads CAPI.
# Create at console.cloud.google.com → APIs & Services → Credentials.
# Get REFRESH_TOKEN via developers.google.com/oauthplayground using scope:
#   https://www.googleapis.com/auth/analytics.readonly
#   https://www.googleapis.com/auth/adwords

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Numeric property ID (not measurement ID). Find at:
#   analytics.google.com → Admin → Property Settings → Property ID

GOOGLE_ANALYTICS_PROPERTY_ID=

# ── Google Ads Conversion API ─────────────────────────────────────────────────
# All optional — CAPI uploads degrade gracefully when absent.

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=


# ── Meta Conversions API ──────────────────────────────────────────────────────

# [optional] [runtime]
META_ACCESS_TOKEN=
META_PIXEL_ID=
# Only needed for testing CAPI events in Events Manager:
META_TEST_EVENT_CODE=


# ── Kafka (telemetry ingest) ──────────────────────────────────────────────────

# [optional] [runtime] Comma-separated broker list, e.g. broker1:9092,broker2:9092
KAFKA_BROKERS=
KAFKA_GROUP_ID=flowen-telemetry


# ── Cloudflare R2 (file storage) ─────────────────────────────────────────────

# [optional] [runtime]
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_BUCKET_NAME=


# ── Privacy / anonymisation ───────────────────────────────────────────────────

# [optional] [runtime] Salt for one-way IP/identifier hashing in audit logs
ANONYMIZER_SALT=a_random_32_char_string_here


# ── Mobile app (Expo) ─────────────────────────────────────────────────────────
# These go in flowen-mobile/.env — EXPO_PUBLIC_ prefix required by Expo bundler.

# EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Vercel (auto-injected — do not set manually) ──────────────────────────────
# These are listed for documentation only; Vercel sets them automatically.

# VERCEL=1
# VERCEL_REGION=iad1
# NEXT_PUBLIC_VERCEL_ENV=production
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=abc123...
# NODE_ENV=production
WS_TOKEN_SECRET=                  # 32-byte random secret for signing WebSocket tokens (openssl rand -base64 32)
