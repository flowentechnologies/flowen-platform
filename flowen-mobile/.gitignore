# JS dependencies — never commit
node_modules/

# Expo managed-workflow output
.expo/
dist/
web-build/

# Environment — never commit secrets
.env
.env.local

# macOS
.DS_Store

# Metro bundler cache
.metro-health-check*

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ── iOS — ignore Xcode generated/build artifacts; keep source ──────────────
ios/build/
ios/Pods/
ios/DerivedData/
ios/*.xcworkspace
ios/*.xcodeproj/xcuserdata/
# Generated by expo prebuild — keep our hand-written FlowenAudio/ source
ios/FlowenMobile/          # generated app shell; FlowenAudio/ stays committed
ios/FlowenMobile.xcodeproj/  # generated; rebuilt by prebuild
# Podfile/Podfile.lock are committed: ios/ is a checked-in bare project (like
# android/), and EAS Build skips `expo prebuild` when it finds an ios/ dir —
# nothing else regenerates them before `pod install` runs.

# ── Android — ignore Gradle build artifacts; keep source ──────────────────
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/debug.keystore
# Generated by expo prebuild; keep our hand-written app/src/main/ source
android/app/src/main/assets/   # generated JS bundle assets
