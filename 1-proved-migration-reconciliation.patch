diff --git a/supabase/migrations/20260918004403_revoke_direct_execute_slp_trigger_functions.sql b/supabase/migrations/20260918004403_revoke_direct_execute_slp_trigger_functions.sql
new file mode 100644
index 0000000..6a1535c
--- /dev/null
+++ b/supabase/migrations/20260918004403_revoke_direct_execute_slp_trigger_functions.sql
@@ -0,0 +1,16 @@
+-- Recovered original Production migration SQL. Already recorded remotely.
+-- notify_slp_new_message and notify_slp_session_completed are trigger
+-- functions (RETURNS trigger, reference NEW.*) fired AFTER INSERT on
+-- slp_messages and practice_sessions respectively — confirmed via
+-- information_schema.triggers. They were never meant to be called
+-- directly; Postgres exposes every function to anon/authenticated via
+-- PostgREST's /rpc/ endpoint by default unless EXECUTE is revoked, which
+-- is what the security advisor (anon/authenticated_security_definer_
+-- function_executable) is flagging. Revoking direct EXECUTE does not
+-- affect the triggers themselves — a trigger invokes its function using
+-- the privileges baked into SECURITY DEFINER regardless of who performed
+-- the INSERT, independent of these GRANTs, which only govern explicit
+-- direct calls (SQL or PostgREST RPC).
+
+revoke execute on function public.notify_slp_new_message() from anon, authenticated;
+revoke execute on function public.notify_slp_session_completed() from anon, authenticated;
diff --git a/supabase/migrations/20260918004434_revoke_public_execute_slp_trigger_functions.sql b/supabase/migrations/20260918004434_revoke_public_execute_slp_trigger_functions.sql
new file mode 100644
index 0000000..bfe29be
--- /dev/null
+++ b/supabase/migrations/20260918004434_revoke_public_execute_slp_trigger_functions.sql
@@ -0,0 +1,14 @@
+-- Recovered original Production migration SQL. Already recorded remotely.
+-- The previous migration revoked EXECUTE from anon/authenticated directly,
+-- but pg_proc.proacl showed the actual grant was to PUBLIC
+-- ({=X/postgres,...}) — every role, including anon/authenticated, inherits
+-- EXECUTE through PUBLIC regardless of any role-specific revoke, so that
+-- migration was a no-op. Revoking from PUBLIC directly is what's needed.
+--
+-- Trigger firing is unaffected: Postgres invokes a trigger function using
+-- its own internal mechanism when a row is inserted, not via a role
+-- performing a direct function call, so it doesn't consult the caller's
+-- EXECUTE grant on the trigger function at all.
+
+revoke execute on function public.notify_slp_new_message() from public;
+revoke execute on function public.notify_slp_session_completed() from public;
