+-- grep that all five are only ever queried through adminDb() (service
+-- role, which bypasses RLS), never the anon/authenticated client, so
+-- enabling RLS with no policies is safe and closes the gap flagged by
+-- Supabase's security advisor (rls_disabled_in_public, ERROR level).
+
+alter table public.explee_searches enable row level security;
+alter table public.explee_prospects enable row level security;
+alter table public.explee_campaign_imports enable row level security;
+alter table public.explee_dedup_lists enable row level security;
